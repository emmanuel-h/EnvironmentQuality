<resources>
    <!--
        The app is entirely Compose: EnvironmentQualityTheme owns every colour. All
        this theme still has to do is dress the window for the frames before the
        first composition and keep the system bars out of the way.

        The light navigation bar arrived in API 27 and the app opens at 24, so it
        is added by the -v27 overlay rather than declared here.
    -->
    <style name="Base.Theme.EnvironmentQuality" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.EnvironmentQuality" parent="Base.Theme.EnvironmentQuality" />

    <style name="Base.Theme.EnvironmentQuality.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EnvironmentQuality</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.EnvironmentQuality.Splash" parent="Base.Theme.EnvironmentQuality.Splash" />
</resources>
