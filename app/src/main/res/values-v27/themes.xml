<resources>
    <!--
        android:windowLightNavigationBar arrived in API 27. Everything else about
        the window is declared on Base.Theme.EnvironmentQuality in values/.
    -->
    <style name="Theme.EnvironmentQuality" parent="Base.Theme.EnvironmentQuality">
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.EnvironmentQuality.Splash" parent="Base.Theme.EnvironmentQuality.Splash">
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
